# Names only — never put real values in this file (the repo is public).
# Vercel: Project → Settings → Environment Variables (Production + Preview).
# Cloud session: the environment's "Environment variables". Local Mac: copy to .env.local (git-ignored).

# --- required in production
MODEL_API_KEY=                  # Meta Model API (Muse Spark / Wonder / Image / Voice, SAM 3.1) — server only
BASETEN_API_KEY=                # Baseten (Muse Spark Open) — server only
NEXT_PUBLIC_SUPABASE_URL=       # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # public by design (RLS: read-only public data)
SUPABASE_SERVICE_ROLE_KEY=      # server only — never NEXT_PUBLIC_
CRON_SECRET=                    # random 32+ chars; Vercel Cron sends it as "Authorization: Bearer …"

# --- optional (defaults shown)
AI_MODE=auto                    # auto (provider routing) | mock (fixtures, no AI calls)
AI_DAILY_CAP_USD=10             # global AI spend cap per IST day; over it every job uses its no-AI fallback
OSRM_URL=https://router.project-osrm.org
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- scripts only (never needed on Vercel)
# SUPABASE_DB_URL=              # only used to derive the project URL in old scripts
# OFFICIAL_PASSWORD=            # pnpm create-official --dept … for a real (non-demo) official account
