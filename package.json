{
  "name": "pathfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('public/vendor',{recursive:true});require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/vendor/maplibre-gl-worker.mjs')\"",
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').mkdirSync('public/vendor',{recursive:true});require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/vendor/maplibre-gl-worker.mjs')\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "hello:meta": "node --env-file-if-exists=.env.local scripts/hello-meta.ts",
    "hello:baseten": "node --env-file-if-exists=.env.local scripts/hello-baseten.ts",
    "test:tools-baseten": "node --env-file-if-exists=.env.local scripts/test-tools-baseten.ts",
    "test:vision": "node --env-file-if-exists=.env.local scripts/test-vision.ts",
    "test:sam": "node --env-file-if-exists=.env.local scripts/test-sam.ts",
    "test:voice": "node --env-file-if-exists=.env.local scripts/test-voice.ts",
    "test:pipeline": "node --env-file-if-exists=.env.local scripts/test-pipeline.ts",
    "test:claim": "node --env-file-if-exists=.env.local scripts/test-claim.ts",
    "test:route-check": "node --env-file-if-exists=.env.local scripts/test-route-check.ts",
    "fetch-roads": "node --env-file-if-exists=.env.local scripts/fetch-roads.ts",
    "fetch-places": "node --env-file-if-exists=.env.local scripts/fetch-places.ts",
    "load-segments": "node --env-file-if-exists=.env.local scripts/load-segments.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "ingest-news": "node --env-file-if-exists=.env.local scripts/ingest-news.ts",
    "test:road-watch": "node --env-file-if-exists=.env.local scripts/test-road-watch.ts",
    "test:risk": "node --env-file-if-exists=.env.local scripts/test-risk.ts",
